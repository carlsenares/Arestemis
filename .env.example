# Copy to .env and fill in. NEVER commit .env.

# Telegram (from @BotFather, and your chat id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Groq (from console.groq.com -> API Keys)
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Optional per-source proxy (anti-ban escalation). The datacenter IP is the main
# ban risk for the hardest portals; if one starts blocking the IP, route just that
# source through a (residential) proxy here — no code change needed. Leave unset
# for a direct connection (the default; ImmoScout's mobile API works direct today).
# Format: http://user:pass@host:port  (also socks5://...)
# IMMOSCOUT_PROXY=
